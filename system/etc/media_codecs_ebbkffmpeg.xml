<Included>
    <Decoders>
       <MediaCodec name="OMX.ebbk.ffmpeg.audio.wma" type="audio/x-ms-wma" />
	   <MediaCodec name="OMX.ebbk.ffmpeg.video.vc1" type="video/x-ms-wmv" >
	        <Limit name="size" min="16x16" max="1920x1088" />
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Limit name="concurrent-instances" max="16" />
	   </MediaCodec>
	   <MediaCodec name="OMX.ebbk.ffmpeg.video.mjpeg" type="video/x-motion-jpeg">
	        <Limit name="size" min="16x16" max="1080x720" />
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Limit name="concurrent-instances" max="16" />
	   </MediaCodec>
	   <MediaCodec name="OMX.ebbk.ffmpeg.video.flv" type="video/flv1" >
            <Limit name="size" min="16x16" max="1080x720" />
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Limit name="concurrent-instances" max="8" />
       </MediaCodec>
	</Decoders>
</Included>